# Copy to .env and fill in real values. Generate secrets with:
#   openssl rand -hex 32
# Or let scripts/bootstrap.sh (repository root) do it: it creates .env from
# this file with every secret generated, sets PULS_TIME_ZONE, starts the
# stack and prints the pairing details for the app.

# Which published images to run: ghcr.io/pulshealth/{ingest,api,mcp,web}
# carry one tag per release (e.g. 0.2.0), a floating major.minor tag, and
# `latest` (the newest release). Defaults to latest when unset. Upgrading is:
# set the new version here, bring the checkout to the same release (`git pull`,
# or `git checkout v<version>` — the compose file and the schema files come
# from it), then `docker compose pull && docker compose up -d` (`make pull up`);
# the migrate service applies any new schema files first.
# Ignored by the developer overlay (compose.build.yml), which builds from
# the checkout instead. See server/README.md, "Images and versions".
# PULS_VERSION=latest

# ---------------------------------------------------------------------------
# The IANA time zone your phone lives in, e.g. America/Los_Angeles or
# Europe/Berlin. Every daily view (the metric_daily view, Grafana's daily
# panels, the product API's local-day ranges, the web viewer) buckets samples
# by this calendar, and it has to match the phone's zone because the on-device
# daily aggregates HealthKit computes are already in the phone's local
# calendar. The migrate service stores it on the database on every start
# (db/migrations/013_time_zone.sh, ALTER DATABASE … SET), so changing it later
# is: edit this value, `docker compose up -d`. Defaults to UTC when unset.
PULS_TIME_ZONE=UTC
# ---------------------------------------------------------------------------

# PostgreSQL superuser password (user: postgres, db: postgres). Held by the
# db and migrate services only; no app container sees it.
POSTGRES_PASSWORD=change-me

# Shared bearer token the PulsHealth iOS app sends in Authorization: Bearer <token>.
# Optional: per-device tokens (`make devices ARGS='issue --user <uuid> --name
# <label>'`) are hashed at rest, bound to one user and revocable one at a
# time, and work alongside it. Once every phone has its own, set
# PULS_ALLOW_SHARED_TOKEN=false (or empty this value) and the shared token
# stops authenticating. See server/README.md, "Tokens".
PULS_TOKEN=change-me
# PULS_ALLOW_SHARED_TOKEN=true

# Static bearer token product API consumers send in Authorization: Bearer <token>
PULS_API_TOKEN=change-me

# Static bearer token AI clients send to the MCP server's HTTP transport
# (the `mcp` service, Authorization: Bearer <token>). It grants read access to
# the health data, so treat it like PULS_API_TOKEN; keep the two distinct so
# either can be rotated alone. Only the stdio mode of the binary (run on a
# laptop by Claude Desktop, Claude Code, Cursor) does without it. See docs/ai.md.
PULS_MCP_TOKEN=change-me

# Grafana web UI administrator credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Password for the read-only `grafana` database role used by the datasource
GRAFANA_DB_PASSWORD=change-me

# Password for the read-only `api_reader` database role used by the product API
API_DB_PASSWORD=change-me

# Password for the scoped `ingest` database role the ingest server (the only
# internet-facing service) connects as. The role can read and write rows in
# `public` but cannot create or drop tables, change roles, or run COPY TO
# PROGRAM. The migrate service creates it and keeps its password equal to this
# value on every `docker compose up -d`.
INGEST_DB_PASSWORD=change-me

# Password for the `web_app` database role, which only the web viewer's
# accounts mode (WEB_ACCOUNTS=true, see web/README.md "Access control")
# connects as. The role reads health data solely through per-user views, so a
# signed-in person can only ever be shown their own records. Optional: leave
# it unset and the role is not created. scripts/bootstrap.sh generates one on
# a fresh install; by hand, `openssl rand -hex 32`.
# WEB_DB_PASSWORD=

# Which role the ingest server connects as; defaults to `ingest`. To run it as
# the postgres superuser instead (not recommended), set this to postgres and
# INGEST_DB_PASSWORD to the same value as POSTGRES_PASSWORD.
# INGEST_DB_USER=ingest

# Where Grafana sends every alert (provisioning/alerting/contact-points.yml).
GRAFANA_ALERT_EMAIL=you@example.com

# Alert email delivery (Grafana -> SMTP). Alert rules are always provisioned and
# always evaluate; these only control whether the mail actually goes out.
#
# For Gmail this MUST be an App Password, not the account password:
#   https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
# Paste it without spaces. Then set GRAFANA_SMTP_ENABLED=true and restart
# Grafana. Verify from the UI: Alerting -> Contact points -> puls-email -> Test.
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=you@gmail.com
GRAFANA_SMTP_PASSWORD=change-me
# Defaults to GRAFANA_SMTP_USER when omitted. Gmail rewrites the From header to
# the authenticated account anyway, so a custom value is cosmetic.
# GRAFANA_SMTP_FROM=you@gmail.com

# The user the product API and the web viewer serve when a request names none
# (the seeded default). Every phone gets its own user ID under the app's
# Settings → User; this is the one the readers show by default.
PULS_USER_ID=5ea4d000-0000-4000-8000-000000000001

# Whether the product API may answer for anyone else. Off (the default), every
# request is PULS_USER_ID's data and a ?user=<uuid> naming another user is a
# 403. Set it to true once a second person syncs to this server: ?user= then
# selects any user (GET /v1/users lists them) — which means the ONE static
# PULS_API_TOKEN reads everyone's data, so a token handed to a ChatGPT Action
# or an MCP client reads the whole household, not one person. Turn it on only
# when that is what you want. See server/README.md, "Product API".
# PULS_MULTI_USER=false

# Pin the MCP connector (the `mcp` service) to one person: every request it
# makes to the product API names this user, and an assistant asking about
# anyone else is refused before the API is asked. Leave it unset and each
# tool call may name a user (subject to the API's PULS_MULTI_USER), falling
# back to PULS_USER_ID above. See docs/ai.md.
# PULS_MCP_USER_ID=

# Password for the web viewer. When set, every page asks for it over HTTP
# Basic — any username is accepted, the password is the credential — and only
# /api/healthz stays open so container health checks keep working. When empty
# or absent the viewer has NO login: anyone who can reach the port reads every
# health record of PULS_USER_ID (that was the only behaviour before, and it is
# what the viewer's startup log warns about). scripts/bootstrap.sh generates
# one on a fresh install and prints it with the pairing block; to turn it off
# again, empty this value and `docker compose up -d web`. Basic auth sends the
# password on every request, so keep WEB_BIND_ADDR private or put TLS in front
# regardless. See web/README.md, "Access control".
# WEB_AUTH_PASSWORD=

# Accounts mode for the web viewer: instead of one shared password, each
# person signs in with their own email and password and sees only their own
# records — the database enforces it (the web_app role, WEB_DB_PASSWORD
# above). Invite-only: `make web-invite ARGS='--user <uuid> --email <address>'`
# prints a one-time link. It needs HTTPS in front of the viewer (plain HTTP is
# refused), so behind a TLS proxy also set TRUST_PROXY_HEADERS=true, and the
# viewer must connect as web_app. All four lines, uncommented:
# WEB_ACCOUNTS=true
# WEB_DATABASE_URL=postgres://web_app:${WEB_DB_PASSWORD}@db:5432/postgres?sslmode=disable
# WEB_PUBLIC_URL=https://viewer.example.com
# WEB_CLIENT_IP_HEADER=cf-connecting-ip     # behind Cloudflare; else leave unset
# See web/README.md, "Access control".

# A Cloudflare Tunnel for the web viewer (the `tunnel` Compose service): serves
# it on a hostname of yours without opening a port. Create the tunnel in the
# Cloudflare dashboard, route the hostname to http://web:3000, and paste its
# token here; COMPOSE_PROFILES=tunnel starts it on every `docker compose up -d`.
# Use it with accounts mode above, never with an open or basic viewer. See
# server/README.md, "Exposing the server".
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Web viewer bind address; defaults to 127.0.0.1 when omitted. To reach the
# viewer from other machines, bind it to a private interface (e.g. the host's
# `tailscale ip -4`) rather than 0.0.0.0.
# WEB_BIND_ADDR=100.x.y.z

# Ingest bind address; defaults to 127.0.0.1 when omitted, which is right
# whenever a TLS proxy (reverse proxy, Tailscale Serve/Funnel) sits in front
# of port 8080. 0.0.0.0 — what `scripts/bootstrap.sh --lan` writes here —
# publishes the port on every interface so a phone on the same Wi-Fi can sync
# to plain http://<this host's LAN IP>:8080 with no proxy at all. The trade-off:
# plaintext on your LAN, and the bearer token is the only thing standing
# between that network and your health data. Use it on a network you control;
# for anything beyond it, keep the default and expose the proxy's HTTPS URL.
# INGEST_BIND_ADDR=127.0.0.1

# Whether ingest may believe the X-Forwarded-For request header when deciding
# which client an authentication failure belongs to (it rate-limits failed
# authentications per client IP; successful syncs are never throttled).
# Defaults to false, which keys the limit on the TCP peer address — right for
# INGEST_BIND_ADDR=0.0.0.0 and for a proxy that does not rewrite the header.
# Set it to true ONLY when a proxy that always overwrites X-Forwarded-For
# (reverse proxy, Tailscale Serve/Funnel) is the only way to reach port 8080:
# the header is otherwise attacker-controlled, and trusting it lets one
# attacker look like an unlimited number of clients. See server/README.md,
# "Rate limiting".
# TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Backups. OFF unless you start the `backup` profile:
#   docker compose --profile backup up -d backup   # a pg_dump on a schedule
#   make backup                                # one dump, right now
#   make backup-list / make restore FILE=...   # see them / put one back
# Nothing else in this stack copies your data anywhere. See server/README.md,
# "Backup & restore", which also has the restore drill.

# Time between scheduled dumps: 24h, 90m, 3600s, or bare seconds. Relative to
# when the container started, not to the wall clock (the schedule is a sleep
# loop, not cron — see server/backup/backup.sh). Defaults to 24h.
# PULS_BACKUP_INTERVAL=24h

# Dumps older than this many days are deleted after each run; 0 keeps
# everything. The newest dump is never deleted, however old it is. Default 14.
# PULS_BACKUP_KEEP_DAYS=14

# Where dumps are written. Unset, they go to the `backups` Docker volume —
# which is on the same disk as the database, so it survives a bad migration
# but not a dead drive. Point it at a path (an external disk, a NAS mount, an
# absolute or ./relative directory) to get a copy that outlives the machine.
# PULS_BACKUP_DIR=/mnt/backup/pulshealth
# ---------------------------------------------------------------------------

# The URL the phone should use, when it is not the LAN address of this host —
# e.g. the HTTPS URL of the TLS proxy or Tailscale Serve/Funnel listener in
# front of port 8080. Used for pairing only, never by the running server:
# scripts/bootstrap.sh puts it in the pairing block and QR code instead of
# http://<LAN IP>:8080 (`--url` sets it), and `ingest devices issue` — what
# `make devices ARGS='issue …'` runs — puts it in the QR code of a new device
# token.
# PULS_PUBLIC_URL=https://health.example.net
