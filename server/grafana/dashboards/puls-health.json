          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 day', c.start_ts - INTERVAL '6 hours', '${tz}') + INTERVAL '6 hours' AS time, CASE c.value WHEN 1 THEN 'Asleep' WHEN 3 THEN 'Core' WHEN 4 THEN 'Deep' WHEN 5 THEN 'REM' END AS metric, sum(extract(epoch FROM (c.end_ts - c.start_ts))) / 60 AS value FROM category_samples c JOIN sample_types t USING (type_id) WHERE c.user_id = '${user}'::uuid AND t.identifier = 'HKCategoryTypeIdentifierSleepAnalysis' AND c.value IN (1, 3, 4, 5) AND $__timeFilter(c.start_ts) GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Sleep Stage Minutes per Night",
      "type": "timeseries",
      "description": "Asleep minutes per night by stage ('In Bed' excluded). Nights split at 06:00 local, so a sleep ending after midnight counts toward the evening it started."
